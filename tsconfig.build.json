{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/index.ts", "src/core/**/*.ts", "src/scanner/**/*.ts", "src/config.ts", "src/platform.ts"],
  "exclude": ["node_modules", "src/stdio/**", "tests/**", "scripts/**", "**/*.spec.ts"]
}
